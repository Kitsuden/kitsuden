{
  "name": "@kitsuden/api",
  "version": "0.9.0-beta",
  "description": "The Kitsuden API server (private: run it from this repository).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitsuden/kitsuden.git",
    "directory": "apps/api"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden/tree/main/apps/api#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external sharp --external @node-rs/argon2",
    "build:node": "bun build src/node-server.ts --outdir dist-node --target node --external sharp --external @node-rs/argon2",
    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js",
    "start:node": "node dist-node/node-server.js",
    "mcp-server": "bun run src/mcp-server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:status": "bun run scripts/migrate.ts --status",
    "db:migrate:dry": "bun run scripts/migrate.ts --dry-run",
    "db:migrate:baseline": "bun run scripts/migrate.ts --baseline",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "seed:mcp": "bun run scripts/seed-mcp-test.ts",
    "test": "node ../../scripts/test-db.mjs api",
    "test:unit": "node scripts/isolated-test.mjs",
    "test:schemathesis": "bun run scripts/schemathesis.ts",
    "test:watch": "node ../../scripts/test-db.mjs exec -- bun test --watch",
    "test:auth": "node ../../scripts/test-db.mjs exec -- bun test src/tests/auth.test.ts",
    "test:datasets": "node ../../scripts/test-db.mjs exec -- bun test src/tests/datasets.test.ts",
    "test:modules": "node ../../scripts/test-db.mjs exec -- bun test src/tests/modules.test.ts",
    "test:rls": "node ../../scripts/test-db.mjs exec -- bun test src/tests/rls.test.ts",
    "test:coverage": "node ../../scripts/test-db.mjs exec -- bun test --coverage",
    "test:realtime": "node ../../scripts/test-db.mjs exec -- bun run src/tests/realtime.test.ts",
    "test:db:up": "node ../../scripts/test-db.mjs up",
    "test:db:down": "node ../../scripts/test-db.mjs down",
    "test:db:migrate": "node ../../scripts/test-db.mjs migrate",
    "test:all": "node ../../scripts/test-db.mjs api-all",
    "test:memory": "cross-env KITSUDEN_TEST_DB=memory node ../../scripts/test-db.mjs exec -- bun test",
    "auth:migrate": "bun run scripts/migrate-api-keys-to-agents.ts",
    "db:rls": "bun run scripts/apply-rls.ts",
    "db:verify:rls": "bun run scripts/verify-rls.ts",
    "db:backup": "bun run scripts/backup.ts",
    "db:backup:list": "bun run scripts/backup.ts --list",
    "db:restore": "bun run scripts/backup.ts --restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-validator": "^0.9.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@kitsuden/engine": "workspace:*",
    "@kitsuden/mcp-server": "workspace:^",
    "@kitsuden/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@node-rs/argon2": "^2.0.2",
    "@tron-format/tron": "0.1.3",
    "better-auth": "~1.7.14",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.9.0",
    "graphql-type-json": "^0.3.2",
    "hono": "4.13.13",
    "hono-rate-limiter": "^0.4.0",
    "nodemailer": "^10.2.1",
    "ollama": "^0.6.3",
    "openai": "^6.46.0",
    "openapi3-ts": "^4.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "quickjs-emscripten-core": "0.32.0",
    "redis": "^5.11.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@toon-format/toon": "4.4.0",
    "@types/bun": "^1.2.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.11",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3"
  }
}
