# ═══════════════════════════════════════════════════════════════════════════
# Kitsuden: environment for TESTS. Copied to .env.test (ignored by git) by
# `pnpm test:db:up` when that file is absent.
#
# Every value here is a throwaway for a container that only listens on
# 127.0.0.1. Never put a real credential in this file.
#
#   pnpm test:db:up     # start the test Postgres and Valkey, and migrate
#   pnpm test:api       # run the API suite (loads this file by itself)
#   pnpm test:db:down   # stop them
#
# A variable already set in your environment wins over this file.
# ═══════════════════════════════════════════════════════════════════════════

# --- Test PostgreSQL (used by docker-compose.test.yml) ---
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=kitsuden_test_only_not_a_secret
POSTGRES_DB=kitsuden_test
POSTGRES_PORT=5434

# Must match the values above. scripts/test-db.mjs refuses anything that does not
# look like a test database on this machine.
DATABASE_URL=postgres://kitsuden:kitsuden_test_only_not_a_secret@127.0.0.1:5434/kitsuden_test

REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
PORT=3101
API_URL=http://127.0.0.1:3101
ADMIN_URL=http://localhost:5173

BETTER_AUTH_URL=http://127.0.0.1:3101
BETTER_AUTH_SECRET=test-only-not-a-secret-test-only-not-a-secret

# postgres: real PostgreSQL (recommended). memory: pg-mem, faster but less compatible.
KITSUDEN_TEST_DB=postgres
