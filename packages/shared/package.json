{
  "name": "@kitsuden/shared",
  "version": "0.9.0-beta",
  "description": "Shared types, schemas, and utilities for Kitsuden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepare": "node scripts/prepare.mjs",
    "dev": "bun run scripts/build.ts --watch",
    "typecheck": "pnpm exec tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kitsuden",
    "cms",
    "baas",
    "types",
    "schemas",
    "zod",
    "typescript"
  ],
  "dependencies": {
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
