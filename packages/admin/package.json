{
  "name": "@kitsuden/admin",
  "version": "0.9.0-beta",
  "description": "The Kitsuden admin panel (private: built into the admin image).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitsuden/kitsuden.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden/tree/main/packages/admin#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources \"js,svelte\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources \"js,svelte\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.15",
    "@floating-ui/dom": "^1.8.0",
    "@kitsuden/shared": "workspace:*",
    "better-auth": "~1.7.14",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.17",
    "lucide-svelte": "^0.575.0",
    "marked": "^17.0.3",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
