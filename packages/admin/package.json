    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/cytoscape": "^3.21.0",
    "autoprefixer": "^10.4.0",
    "cytoscape": "^3.26.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
