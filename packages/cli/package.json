{
  "name": "@kitsuden/cli",
  "version": "0.9.0-beta",
  "description": "Command-line tools for Kitsuden: install kons, scaffold projects and websites, run the MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitsuden/kitsuden.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "type": "module",
  "bin": {
    "kitsuden": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "node --test \"tests/kon.test.mjs\" \"tests/kon-security.test.mjs\" \"tests/registry.test.mjs\" \"tests/docker-overlay.test.mjs\"",
    "prepack": "pnpm build && node scripts/package-starter.mjs",
    "test:all": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@kitsuden/codegen": "workspace:*",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "diff": "^5.2.0",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "inquirer": "^9.2.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/diff": "^5.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
