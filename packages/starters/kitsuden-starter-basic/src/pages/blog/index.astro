---
/** Blog index, paginated with `?page=` */
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { t } from "../../i18n";
import { site } from "../../lib/site";

const PER_PAGE = 10;
const requested = Number(Astro.url.searchParams.get("page") ?? "1");
const pageNumber = Number.isInteger(requested) && requested >= 1 && requested <= 1000 ? requested : 1;
const list = await Astro.locals.kitsuden.posts.list({ page: pageNumber, limit: PER_PAGE, locale: site.locale });

if (list && pageNumber > 1 && pageNumber > list.totalPages) return Astro.rewrite("/404");
const locale = site.locale;
const canonicalPath = pageNumber > 1 ? `/blog?page=${pageNumber}` : "/blog";
---

<Base title={t(locale, "blog.title")} description={t(locale, "blog.description")} canonicalPath={canonicalPath} noindex={!list}>
  <h1 class="blog-title">{t(locale, "blog.title")}</h1>
  {!list && <p class="muted">{t(locale, "blog.unavailable")}</p>}
  {list && list.docs.length === 0 && <p class="muted">{t(locale, "blog.empty")}</p>}
  {list && list.docs.length > 0 && <PostList posts={list.docs} />}
  {
    list && list.totalPages > 1 && (
      <nav class="pager" aria-label={t(locale, "blog.page", { page: pageNumber, total: list.totalPages })}>
        {list.hasPrevPage ? <a href={pageNumber - 1 === 1 ? "/blog" : `/blog?page=${pageNumber - 1}`} rel="prev">← {t(locale, "blog.newer")}</a> : <span />}
        <span class="muted">{t(locale, "blog.page", { page: pageNumber, total: list.totalPages })}</span>
        {list.hasNextPage ? <a href={`/blog?page=${pageNumber + 1}`} rel="next">{t(locale, "blog.older")} →</a> : <span />}
      </nav>
    )
  }
</Base>

<style>
  .blog-title { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0 0 2rem; }
  .pager { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 2rem; }
</style>
