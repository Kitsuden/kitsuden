---
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
import { site } from "../lib/site";

const locale = site.locale;
Astro.response.status = 404;
---

<Base title={t(locale, "notFound.title")} noindex>
  <section class="not-found">
    <h1>{t(locale, "notFound.title")}</h1>
    <p class="muted">{t(locale, "notFound.body")}</p>
    <p><a class="button button--primary" href="/">{t(locale, "notFound.back")}</a></p>
  </section>
</Base>

<style>
  .not-found { padding: 3rem 0; max-width: 36rem; }
</style>
