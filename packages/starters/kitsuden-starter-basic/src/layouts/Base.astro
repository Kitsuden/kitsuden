---
/**
 * The page shell: SEO tags, theme, header with navigation, footer.
 *
 * Navigation lists the published pages of the page builder (the homepage is
 * "Home") plus the blog. It never breaks a page: if the API does not answer,
 * the menu is just shorter.
 */
import "../styles/global.css";

import EditorToolbar from "../inti/EditorToolbar.astro";
import { t } from "../i18n";
import type { PageSummary } from "../lib/kitsuden";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string | null;
  /** Site path or absolute URL of the social image */
  image?: string | null;
  /** Path for the canonical URL (default: the current path, no query) */
  canonicalPath?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string | null;
  /** Show the Inti editor (only true for an editor, with INTI=true) */
  editor?: boolean;
}

const {
  title,
  description,
  image,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  type = "website",
  publishedTime,
  editor = false,
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, base).href;
const fullTitle = title && title !== site.name ? `${title} · ${site.name}` : site.name;
const imageUrl = image ? new URL(image, base).href : null;
const locale = site.locale;

let pages: PageSummary[] = [];
try {
  pages = await Astro.locals.kitsuden.pages.list();
} catch {
  pages = [];
}
const nav = [
  { href: "/", label: t(locale, "nav.home") },
  ...pages
    .filter((p) => !p.isHomepage && p.slug !== "home")
    .slice(0, 6)
    .map((p) => ({ href: `/${p.slug}`, label: p.title })),
  { href: "/blog", label: t(locale, "nav.blog") },
];
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Before first paint, so a dark-mode visitor never sees a white flash
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "nav.skip")}</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label={t(locale, "theme.toggle")} title={t(locale, "theme.toggle")}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
        </button>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="muted">© {new Date().getFullYear()} {site.name} · <a href="https://github.com/Kitsuden/kitsuden">{t(locale, "footer.powered")}</a></p>
      </div>
    </footer>

    {editor && <EditorToolbar />}

    <script>
      const root = document.documentElement;
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const dark =
          root.dataset.theme === "dark" ||
          (!root.dataset.theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Private mode: the choice lasts until the page is closed
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }
  .site-header__inner { display: flex; align-items: center; gap: 1rem; min-height: 4rem; flex-wrap: wrap; }
  .brand { font-weight: 800; font-size: 1.15rem; color: var(--fg); text-decoration: none; margin-right: auto; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 500; }
  nav a:hover, nav a[aria-current="page"] { color: var(--fg); }
  .theme-toggle { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; border: 1px solid var(--border); background: var(--surface-2); color: var(--fg); cursor: pointer; }
  main { min-height: 60vh; padding-bottom: 4rem; }
  .site-footer { border-top: 1px solid var(--border); padding: 1.5rem 0; font-size: 0.9rem; }
  .site-footer p { margin: 0; }
</style>
