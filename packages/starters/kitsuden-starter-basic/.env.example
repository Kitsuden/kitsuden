# ─── Kitsuden starter ──────────────────────────────────────────────────────
# Copy to .env (same folder). Every value has a default for local development.

# Where THIS server reaches the Kitsuden API (read when the server starts).
# Inside Docker this is usually the internal address, e.g. http://kitsuden_api:3000
KITSUDEN_API_URL=http://localhost:3000

# Public origin of this site: canonical URLs, Open Graph and sitemap.xml.
# Read at BUILD time (rebuild after changing it).
SITE_URL=http://localhost:4321

# Name shown in the header, the <title> and the footer (build time).
SITE_NAME=Kitsuden Starter

# Interface language (src/i18n). Also sent to the blog API as ?locale=.
SITE_LOCALE=en

# Optional. The API limits requests per client IP, and every visitor reaches
# the API through this server. Set this to the API's SITE_API_KEY and the
# API counts each visitor separately (headers x-kitsuden-site and
# x-kitsuden-client). Secret: read at runtime, never written into the build.
# KITSUDEN_SITE_KEY=

# Optional. Behind a reverse proxy (Caddy, nginx) every request comes from the
# proxy: set this to true to take the visitor IP from X-Forwarded-For (the last
# entry, the one the proxy adds). Only if the proxy is the only way in.
# KITSUDEN_TRUST_PROXY=true

# ─── Optional: Inti visual editing (see README) ────────────────────────────
# Build with INTI=true only after installing @intijs/core and
# @intijs/adapter-kitsuden. Without it nothing of Inti is bundled.
# INTI=true
# Agent key with the single scope contenido:editar. Runtime only: pass it to
# `pnpm start`, never to `pnpm build`.
# INTI_KITSUDEN_TOKEN=
