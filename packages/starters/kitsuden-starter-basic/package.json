{
  "name": "@kitsuden/starter-basic",
  "version": "0.9.0-beta",
  "description": "Neutral example frontend for Kitsuden: Astro site that renders page-builder pages, the blog and the media library, with optional Inti visual editing",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden.git",
    "directory": "packages/starters/kitsuden-starter-basic"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:inti": "cross-env INTI=true astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:build": "node --test tests/build.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.2",
    "marked": "^17.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vitest": "~4.0.18"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
