{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    // The kon loader reaches the API's agent engine, whose files import with `@/`.
    "paths": { "@/*": ["../../../apps/api/src/*"] }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist"]
}
