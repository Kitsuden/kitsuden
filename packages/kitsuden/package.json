{
  "name": "kitsuden",
  "version": "0.9.0-beta",
  "description": "Kitsuden in one install: the typed SDK (@kitsuden/sdk) and the `kitsuden` command (@kitsuden/cli). The server runs from the Docker images or the repository.",
  "license": "MIT",
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitsuden/kitsuden.git",
    "directory": "packages/kitsuden"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden/tree/main/packages/kitsuden#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "keywords": [
    "kitsuden",
    "backend",
    "baas",
    "sdk",
    "cli",
    "mcp",
    "ai-agents",
    "postgres",
    "rls"
  ],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kitsuden": "bin/kitsuden.mjs"
  },
  "files": [
    "bin",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "pnpm test && node ../../scripts/release/dist-check.mjs"
  },
  "dependencies": {
    "@kitsuden/cli": "workspace:^",
    "@kitsuden/sdk": "workspace:^"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
