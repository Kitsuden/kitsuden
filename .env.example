# ===================================================================
# Kitsuden - Environment Configuration
# Copy this file to .env and update the values for your environment
# NEVER commit .env to git.
# ===================================================================

# --- Database ---
# ⚠️ RLS only applies if the app connects as a NON-superuser role. The user
# that creates the official Postgres image IS a superuser: fine for development,
# but in production create a separate role (see apps/api/docs/RLS_SETUP_GUIDE.md).
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
POSTGRES_DB=kitsuden_dev
DATABASE_URL=postgres://kitsuden:<CHANGE_ME_POSTGRES_PASSWORD>@localhost:5432/kitsuden_dev
# Connection pool. When every connection is busy for longer than the timeout,
# the API answers 503 + Retry-After instead of 500.
# DB_POOL_MAX=20
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Valkey/Redis (OPTIONAL) ---
# Only needed with several API replicas: it shares cache, rate-limit counters
# and realtime Pub/Sub between them. Without it (a single instance) the API
# keeps them in process memory and uses Postgres LISTEN/NOTIFY for Pub/Sub.
# REDIS_URL=redis://localhost:6379

# --- Background jobs (Postgres queue, docs/install/queue.md) ---
# QUEUE_WORKER=true            # false = this process only enqueues
# QUEUE_POOL_MAX=3             # the worker's own pool, apart from requests
# QUEUE_POLL_MS=2000           # fallback polling (NOTIFY only speeds it up)
# QUEUE_LEASE_SECONDS=300      # a running job is recovered after this
# QUEUE_RETENTION_DAYS=7       # finished jobs are deleted after this
# QUEUE_DATABASE_URL=          # defaults to DATABASE_URL
# DATABASE_LISTEN_URL=         # DIRECT to Postgres if DATABASE_URL goes through PgBouncer
# QUEUE_AGENT_JOB_COST=1       # budget units an agent's job costs when its dispatch sets no cost (0 = free)
# QUEUE_BUDGET_EXHAUSTED=postpone  # postpone (next UTC day) or fail: an agent's job with its budget spent

# --- Request traces, the "glass box" (/api/admin/requests) ---
# TRACES_ENABLED=true                 # off in tests by default
# TRACES_READ_SAMPLING=0.1        # share of successful reads recorded (writes, errors, blocks: always)
# TRACES_RETENTION_DAYS=7

# --- Per-record change history (docs/record-history.md) ---
# RECORD_HISTORY_RETENTION_DAYS=365  # older rows are deleted hourly; empty = 365, 0 = keep forever
# AGENT_AUDIT_RETENTION_DAYS=90      # agent audit log (agent_audit_logs), same rule; empty = 90, 0 = keep forever
# OTEL_EXPORTER_OTLP_ENDPOINT=        # optional: also send the traces as OTLP spans
# OTEL_SERVICE_NAME=kitsuden-api

# --- Local AI (docs/agents/local-ai.md) ---
# EMBEDDINGS_URL=                     # OpenAI-compatible /v1/embeddings server (TEI, Infinity, llama.cpp…)
# EMBEDDINGS_MODEL=
# INJECTION_CLASSIFIER_URL=           # second opinion on proposals; never decides
# OCR_SIDECAR_URL=                    # kon-ingest: OCR for images

# --- Agent notify webhooks (docs/agents/approvals.md) ---
# KITSUDEN_WEBHOOKS_ALLOW_PRIVATE=false   # true only in development: allows http:// and private addresses

# --- Server ---
# API runs on 3000 in Docker/production and by default in dev.
# Admin dev server (Vite) runs on ADMIN_PORT below.
API_PORT=3000
PORT=3000
# Address the API listens on (default 127.0.0.1 outside production, 0.0.0.0 in
# production). HOST=0.0.0.0 reaches it from the network; then the setup token is
# required and sign-up is closed unless KITSUDEN_SIGNUP=open. HOST=:: adds IPv6.
# HOST=0.0.0.0
NODE_ENV=development

# --- Authentication ---
# IMPORTANT: Change to a secure random string in production (min 32 chars)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>
BETTER_AUTH_URL=http://localhost:3001

# --- Public sign-up ---
# open | closed. Closed: nobody creates an account through /api/auth/sign-up/*
# or a first social login. The first administrator (POST /api/system/setup) and
# agent keys are not affected; to add another person, open it for a moment.
# Default: closed with NODE_ENV=production, open otherwise. A site with public
# accounts (comments, tournaments, saved builds) needs KITSUDEN_SIGNUP=open.
# KITSUDEN_SIGNUP=open

# optional | required: admins must enrol an authenticator app (Settings -> Security).
# KITSUDEN_ADMIN_MFA=optional


# --- URLs ---
# Admin dev server (Vite). In Docker/production the admin panel is served on port 3001.
ADMIN_URL=http://localhost:5173
ADMIN_PORT=5173
PUBLIC_API_URL=http://localhost:3000
# OAuth for MCP clients (docs/agents/oauth.md): the public API origin, no path.
# It is the OAuth issuer and the base of the protected resource <issuer>/api/mcp.
# Defaults to BETTER_AUTH_URL. In production it MUST be https, or OAuth turns off.
# OAUTH_ISSUER_URL=https://api.example.com
PUBLIC_SITE_NAME=Kitsuden

# --- Storage (S3/MinIO) ---
DEFAULT_STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=kitsuden-media
S3_REGION=us-east-1
S3_ACCESS_KEY=<CHANGE_ME_MINIO_ACCESS_KEY>
S3_SECRET_KEY=<CHANGE_ME_MINIO_SECRET_KEY>

# --- CORS ---
# CORS with credentials: if an origin is not listed here, comments and the session
# fail from that site (and fail ONLY on interaction: the page loads fine).
# One entry per public WEBSITE, plus the panel. Subdomains of the main
# site (wikis, esports) are resolved by cors-origins.ts, so they are not needed here.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:3001,http://127.0.0.1:3001

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
# Key shared between the API and the public site server. With it, the
# API counts the request limit per VISITOR; without it, all visits
# to the site are a single client and at 300 pages/min the website starts to fail.
# Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_API_KEY=

# --- Logging ---
LOG_LEVEL=info

# --- Feature Flags ---
ENABLE_SWAGGER=true
ENABLE_MCP=true
# Code actions (admin JS in a child process; it is NOT a jail). In
# production they are off unless set to true (an earlier audit).
ENABLE_CODE_ACTIONS=true

# --- Outbound requests (anti-SSRF, lib/safe-fetch.ts) ---
# The sandbox `fetch` and `webhook_out` actions only connect to PUBLIC addresses
# (no localhost, Docker network, 10.x/192.168.x or the cloud metadata service at
# 169.254.169.254), and to the same address that was checked. Explicit
# exceptions for real internal services:
#   KITSUDEN_SANDBOX_ALLOW_INTERNAL_FETCH=true          the sandbox may go anywhere
#   KITSUDEN_WEBHOOK_ALLOW_INTERNAL=n8n,*.internal.lan,10.0.0.5
#                                                       internal hosts a webhook_out may call
#   KITSUDEN_WEBHOOK_ALLOW_INTERNAL=true                any internal host (avoid in production)
# KITSUDEN_SANDBOX_ALLOW_INTERNAL_FETCH=
# KITSUDEN_WEBHOOK_ALLOW_INTERNAL=

# --- Headless Mode (BaaS-only, no admin UI) ---
HEADLESS=false

# --- OAuth Providers (optional) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Discord - the identity of the gaming/esports audience.
# App en https://discord.com/developers/applications; redirect to register:
#   <BETTER_AUTH_URL>/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# ═══════════════════════════════════════════════════════════════════
# LLM Providers (Agents Engine)
# ═══════════════════════════════════════════════════════════════════
# Configure at least one provider. The Agent Engine picks the first
# available in this order: OpenAI > Anthropic > DeepSeek > Ollama.
# You can override the default model with KITSUDEN_LLM_PROVIDER + KITSUDEN_LLM_MODEL.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# When the model declines for safety reasons, the API retries on the model Anthropic recommends (Claude API
# only, on Opus 5.5, Opus 5, Sonnet 5.5, Fable 5 and 5.1). Set to "off" to get the refusal instead.
# ANTHROPIC_FALLBACKS=on

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional: force a specific provider/model
# KITSUDEN_LLM_PROVIDER=openai
# KITSUDEN_LLM_MODEL=gpt-4o


# --- KITSUDEN Secrets Manager (KITSUDEN architecture §7) ---
# Master key to encrypt secrets in the kitsuden_secrets table (AES-256-GCM).
# Required in production (the API refuses to start without it). If not set in
# development, it is derived from BETTER_AUTH_SECRET.
KITSUDEN_SECRETS_KEY=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>

# --- KITSUDEN Vault (KITSUDEN architecture §3) ---
# Enables dynamic schemas with real CREATE/ALTER TABLE + automatic RLS.
# Opt-in: coexists with the JSONB Dataset Engine (ADR-001).
KITSUDEN_VAULT_ENABLED=false

# ── Application role (RLS) ───────────────────────────────────────────────────
# The API must NOT connect as a superuser: Postgres ignores RLS policies
# for superusers, so tenant isolation becomes decorative.
# POSTGRES_USER/POSTGRES_PASSWORD remain the superuser, used only
# for migrating. These two are the account the API runs as; the role is created
# only at startup with just the permissions it needs.
APP_DB_USER=kitsuden_app
APP_DB_PASSWORD=<openssl rand -hex 32>
