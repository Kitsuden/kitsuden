# ===================================================================
# Kitsuden — PRODUCTION variables (server with Docker)
#
# Only want to try it on your machine? ./install.sh (or install.ps1) creates this
# file for you. What follows is for a server with a domain.
#
#   cp .env.production.example .env   and fill in the <...>
#   ./scripts/deploy.sh               (o: docker compose -f docker-compose.yml
#                                      -f docker-compose.tls.yml up -d --build)
#
# Guide: docs/install/server.md
# Every variable explained: docs/install/variables.md
#
# NEVER commit .env to git (it is in .gitignore). Generate each secret with:
#   openssl rand -hex 32
# and do not paste them into loose scripts.
#
# Only the variables that docker-compose.yml,
# docker-compose.tls.yml and scripts/deploy.sh actually read are here: the connection URLs
# (DATABASE_URL, REDIS_URL…) are assembled by compose itself.
#
# A value that STARTS with «<» is a blank to fill in: scripts/deploy.sh
# refuses to continue while any remain. Without a domain (docker-compose.yml only),
# delete or empty the domain and email lines.
# ===================================================================

# Compose project name: prefix of the media volume
# (<project>_kitsuden_uploads_prod). Pin it so it does not depend on
# the folder name.
COMPOSE_PROJECT_NAME=kitsuden

# ── Database (PostgreSQL 16 + pgvector) ─────────────────────────────────
# Superuser: only migrates, creates the app role and makes the backups. The
# Postgres image creates it ONLY the first time (empty volume): changing it later does not
# changes the database.
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=kitsuden_prod

# Role the API runs as (RLS: a superuser skips the policies).
# It is created automatically at startup.
APP_DB_USER=kitsuden_app
APP_DB_PASSWORD=<openssl rand -hex 32>

# Limited role to create tables at runtime (enabling kons from the panel, the
# Vault). It is created automatically at startup. Without it, enabling a kon fails:
# the admin URL is removed before the API starts.
DDL_DB_PASSWORD=<openssl rand -hex 32>

# Valkey (cache and pub/sub). Required: without a password, any process on the
# server could read and rewrite the cache.
VALKEY_PASSWORD=<openssl rand -hex 32>

# ── Application secrets ───────────────────────────────────────────────────
# Minimum 32 characters (the API will not start with a shorter one)
BETTER_AUTH_SECRET=<openssl rand -hex 32>

# --- Public sign-up ---
# open | closed. Closed: nobody creates an account through /api/auth/sign-up/*
# or a first social login. The first administrator (POST /api/system/setup) and
# agent keys are not affected; to add another person, open it for a moment.
# Default: closed with NODE_ENV=production, open otherwise. A site with public
# accounts (comments, tournaments, saved builds) needs KITSUDEN_SIGNUP=open.
KITSUDEN_SIGNUP=closed

# Must admins use an authenticator app (two-factor sign-in)? optional | required.
# Enrol from the panel (Settings -> Security) BEFORE setting required.
KITSUDEN_ADMIN_MFA=optional

# Encrypts the secrets stored in the database. REQUIRED: production refuses to
# start without it (without it, development derives it from BETTER_AUTH_SECRET).
# Losing it = losing those secrets: keep it with the backups. An install that
# ran without it: docs/install/upgrade-and-backups.md (scripts/rekey-secrets.ts).
KITSUDEN_SECRETS_KEY=<openssl rand -hex 32>
# Shared by the API and the web (on the web: KITSUDEN_SITE_KEY; the TLS overlay
# passes it along). With it the request limit is counted per VISITOR; without
# it, the whole site is a single client. Required with the TLS overlay.
SITE_API_KEY=<openssl rand -hex 32>

# ── Domains (docker-compose.tls.yml + docker/Caddyfile) ───────────────────
# DNS A records pointing to the server IP: SITE_DOMAIN, www.SITE_DOMAIN and
# KITSUDEN_DOMAIN. Ports 80 and 443 open.
SITE_DOMAIN=<example.com>
# The panel, and the API the browser uses (its nginx forwards /api/*).
# Empty = panel.<SITE_DOMAIN>
KITSUDEN_DOMAIN=
# Let's Encrypt expiry notices
ACME_EMAIL=<ops@example.com>

# ── Email (REQUIRED in public mode: without it the API will not start) ────
# ONE of the two transports is enough.
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Forces a driver (resend | smtp | log). Empty = Resend if there is a key, SMTP if
# there is a host.
# MAIL_DRIVER=
# With the real domain: providers reject or mark @localhost as spam.
# Format «Name <email>», e.g. My site <noreply@example.com>
MAIL_FROM=<Name <noreply@example.com>>

# ── The public website (kitsuden_web: the neutral starter) ────────────────
# They are BAKED IN when the web is built: changing them requires
# `docker compose -f docker-compose.yml -f docker-compose.tls.yml build kitsuden_web`.
SITE_NAME=Kitsuden
SITE_LOCALE=en
# Web timezone (the API, database and backups always run in UTC)
TZ=UTC

# Top-level routes of YOUR website that a game (kon-games) cannot take as a
# slug, separated by commas. They are added to the common ones from
# packages/shared/src/public-site.ts (blog, api, media, img, legal…).
# KITSUDEN_RESERVED_SEGMENTS=tournaments,shop

# Own compose overlays (another website instead of the starter, extra
# services), separated by commas. Only read by scripts/deploy.sh, which adds them
# AFTER docker-compose.tls.yml.
# KITSUDEN_OVERLAYS=docker-compose.miweb.yml

# ── Storage ───────────────────────────────────────────────────────────────
# `local` = the API volume (/app/data, served at /media).
# `s3` = S3 storage: then S3_ACCESS_KEY and S3_SECRET_KEY are
# required (with `local` they are not needed).
DEFAULT_STORAGE_PROVIDER=local
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=kitsuden-media
# S3_REGION=us-east-1
# S3_PUBLIC_URL=

# ── Backups ───────────────────────────────────────────────────────────────
# Database: pg_dump every BACKUP_INTERVAL_HOURS, BACKUP_KEEP are kept
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Media: full copy every BACKUP_MEDIA_DAYS days, BACKUP_MEDIA_KEEP
# are kept. Everything stays in the kitsuden_backups_prod volume on the SAME
# disk: move it off the machine to survive losing the server.
BACKUP_MEDIA_DAYS=7
BACKUP_MEDIA_KEEP=2

# Point-in-time restore: WAL archiving + a base backup every BACKUP_BASE_DAYS
# days (BACKUP_BASE_KEEP kept). Restarts Postgres when changed. Disk cost and
# restore procedure: docs/install/high-availability.md.
KITSUDEN_PITR=off
# PG_ARCHIVE_TIMEOUT=300
# BACKUP_BASE_DAYS=7
# BACKUP_BASE_KEEP=2
# For docker-compose.replica.yml (a streaming replica):
# REPLICATION_PASSWORD=

# ── Miscellaneous ─────────────────────────────────────────────────────────
LOG_LEVEL=info
# Interactive API documentation at /api/docs (the TLS overlay turns it off
# unless you ask for it)
ENABLE_SWAGGER=false
# Code actions: the JS (from an admin or an agent) runs in QuickJS
# (WebAssembly) inside a child process with no environment and with node --permission:
# no files, no network except the allowlist, no secrets; the Kitsuden API
# only with the scopes the action declares. See docs/agents/sandbox.md.
# Off unless needed.
ENABLE_CODE_ACTIONS=false
# Hosts the code may fetch from (in addition to config.fetchAllow).
# KITSUDEN_SANDBOX_FETCH_ALLOW=api.example.com,*.example.org
# A host that resolves to a private address is refused unless you say otherwise:
# KITSUDEN_SANDBOX_ALLOW_INTERNAL_FETCH=true
# webhook_out actions only post to public addresses; internal receivers by name
# (`true` would open every internal address):
# KITSUDEN_WEBHOOK_ALLOW_INTERNAL=n8n,*.internal.lan
# Customer data (fields marked sensitivity: "customer"/"personal") only goes to these
# hosts; to any other, sandbox fetch refuses and webhooks redact it. See docs/agents/egress.md.
# KITSUDEN_CUSTOMER_DATA_HOSTS=crm.example.com,*.mail.example.com
# External MCP servers (docs/agents/external-mcp.md) must be public https unless:
# KITSUDEN_EXTERNAL_MCP_ALLOW_INTERNAL=true
# Vault: collections with real CREATE TABLE. Off by default on purpose.
# KITSUDEN_VAULT_ENABLED=false

# By default everything listens on 127.0.0.1 and only Caddy (80/443) is public.
# 0.0.0.0 would expose the API and the panel WITHOUT TLS (and Docker bypasses ufw). Postgres and
# Valkey stay on 127.0.0.1 with any value.
# BIND_ADDRESS=127.0.0.1
# Host ports
# API_PORT=3000
# ADMIN_PORT=3001
# DB_PORT=5432
# VALKEY_PORT=6379

# Second install on the same machine: changes the prefix of containers, volumes and
# network (default `kitsuden`), so it shares no data with the first. install.sh
# picks it by itself. Do not change it on an install with data: it would point at
# empty volumes.
# KITSUDEN_INSTANCE=kitsuden

# Image names (by default ghcr.io/kitsuden/kitsuden/api:latest,
# …/admin:latest and …/web:latest). Compose builds them here: they are not downloaded.
# Useful for a second installation on the same machine.
# KITSUDEN_API_IMAGE=
# KITSUDEN_ADMIN_IMAGE=
# KITSUDEN_WEB_IMAGE=

# Social sign-in (GitHub, Google, Discord, Microsoft). A provider is on only when
# both its id and its secret are set. Register this callback with the provider:
# <BETTER_AUTH_URL>/api/auth/callback/<github|google|discord|microsoft>
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common

# kon-payments: plan/price/variant ids that can be purchased, separated
# by commas. In production, nothing is sold without this list.
# PAYMENTS_ALLOWED_PLANS=price_123,price_456

# Days the per-record change history (record_changes, docs/record-history.md)
# is kept; older rows are deleted hourly. Empty = 365; 0 = keep it forever.
# RECORD_HISTORY_RETENTION_DAYS=365

# Days the agent audit log (agent_audit_logs, Approvals -> Audit) is kept;
# older rows are deleted hourly. Empty = 90; 0 = keep it forever.
# AGENT_AUDIT_RETENTION_DAYS=90

# --- OAuth for MCP clients (docs/agents/oauth.md) ---
# Public https origin of the API (no path). Required for Claude/Cursor to
# connect with OAuth; with a non-https value OAuth stays off in production.
# ADMIN_URL must be the panel's public URL (the consent screen lives there).
# Empty = BETTER_AUTH_URL, which docker-compose.tls.yml derives from your domain.
# OAUTH_ISSUER_URL=https://api.example.com
