{
  "name": "kitsuden-cms",
  "version": "0.9.0-beta",
  "private": true,
  "type": "module",
  "description": "Kitsuden: a self-hosted backend for AI agents, on Postgres with row-level security and human approval.",
  "license": "MIT",
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitsuden/kitsuden.git"
  },
  "homepage": "https://github.com/Kitsuden/kitsuden#readme",
  "bugs": {
    "url": "https://github.com/Kitsuden/kitsuden/issues"
  },
  "scripts": {
    "prepare": "husky",
    "test": "pnpm run test:api && pnpm run test:unit",
    "dev": "pnpm --parallel -r dev",
    "dev:api": "cd apps/api && bun run dev",
    "kitsuden": "node packages/cli/dist/index.js",
    "dev:admin": "pnpm --filter @kitsuden/admin dev",
    "build": "pnpm --filter @kitsuden/shared build && pnpm --filter @kitsuden/api build && pnpm --filter @kitsuden/admin build",
    "build:api": "pnpm --filter @kitsuden/api build",
    "build:admin": "pnpm --filter @kitsuden/admin build",
    "build:packages": "pnpm --filter @kitsuden/shared build && pnpm --filter @kitsuden/sdk build && pnpm --filter @kitsuden/mcp-server build && pnpm --filter @kitsuden/cli build",
    "db:generate": "cd apps/api && bun run db:generate",
    "db:migrate": "cd apps/api && bun run db:migrate",
    "db:push": "cd apps/api && bun run db:push",
    "db:seed": "cd apps/api && bun run db:seed",
    "db:studio": "cd apps/api && bun run db:studio",
    "lint": "eslint . --cache",
    "security:scan": "node scripts/security/scan.mjs",
    "lint:fix": "eslint . --fix",
    "lint:all": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:packages": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm -r --no-bail typecheck",
    "typecheck:root": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "typecheck": "pnpm run typecheck:packages && pnpm run typecheck:root",
    "typecheck:all": "pnpm -r typecheck",
    "qa": "pnpm run typecheck && pnpm run lint",
    "test:api": "node scripts/test-db.mjs api",
    "test:api:all": "node scripts/test-db.mjs api-all",
    "auth:migrate": "pnpm --filter @kitsuden/api auth:migrate",
    "test:db:up": "node scripts/test-db.mjs up",
    "test:db:down": "node scripts/test-db.mjs down",
    "test:db:migrate": "node scripts/test-db.mjs migrate",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config=tests/unit/vitest.config.ts",
    "verify:kons": "cd apps/api && bun run scripts/migrate.ts --all-kons --no-rls && bun run scripts/verify-schema.ts --all-kons",
    "verify:routes": "cd apps/api && bun run scripts/smoke-routes.ts",
    "test:isolation": "node scripts/check-test-isolation.mjs",
    "test:unit:watch": "vitest --config=tests/unit/vitest.config.ts",
    "test:unit:coverage": "vitest run --config=tests/unit/vitest.config.ts --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:mcp": "npx playwright test tests/e2e/mcp-vector-search.e2e.spec.ts --config=tests/e2e/playwright.e2e.config.ts",
    "test:e2e:mcp:ui": "npx playwright test tests/e2e/mcp-vector-search.e2e.spec.ts --config=tests/e2e/playwright.e2e.config.ts --ui",
    "seed:mcp": "bun run apps/api/scripts/seed-mcp-test.ts",
    "pw:init": "npx playwright init-agents --loop=vscode",
    "pw:install": "npx playwright install chromium",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "prod:up": "docker compose -f docker-compose.yml up -d",
    "prod:down": "docker compose -f docker-compose.yml down",
    "prod:build": "docker compose -f docker-compose.yml build kitsuden_api kitsuden_admin",
    "prod:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:infra": "docker compose -f docker-compose.dev.yml up -d",
    "docker:nuke": "node scripts/docker-nuke.mjs",
    "docker:build:api": "docker build -f docker/Dockerfile.prod --target api -t ghcr.io/kitsuden/kitsuden/api:latest .",
    "docker:build:admin": "docker build -f docker/Dockerfile.prod --target admin -t ghcr.io/kitsuden/kitsuden/admin:latest .",
    "docker:build:mcp": "docker build -f docker/mcp/Dockerfile --target production -t ghcr.io/kitsuden/kitsuden/mcp:latest .",
    "docker:build:all": "pnpm run docker:build:api && pnpm run docker:build:admin && pnpm run docker:build:mcp",
    "clean": "node scripts/clean.mjs",
    "typecheck:core": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm --filter @kitsuden/api --filter @kitsuden/shared --filter @kitsuden/admin --filter @kitsuden/sdk --filter @kitsuden/mcp-server --filter @kitsuden/cli typecheck",
    "validate:docker": "node scripts/validate-docker.mjs",
    "sdk:openapi": "pnpm --filter @kitsuden/shared build && cd apps/api && bun --no-env-file scripts/sdk-openapi.ts",
    "sdk:generate": "node scripts/sdk/generate.mjs",
    "sdk:watch": "node scripts/sdk/watch.mjs",
    "sync:tallao": "node scripts/sync-tallao.mjs",
    "sdk:check": "node scripts/sdk/generate.mjs --check && node scripts/sdk/tron-fixtures.mjs --check && cd apps/api && bun --no-env-file scripts/sdk-openapi.ts --check",
    "test:sdk": "pnpm run test:sdk:ts && pnpm run test:sdk:py",
    "test:sdk:ts": "vitest run --config packages/sdk/vitest.config.ts",
    "test:sdk:py": "cd packages/sdk-python && uv run --no-project --python 3.12 --with \"httpx>=0.24\" --with pytest -- python -m pytest -q -p no:cacheprovider tests",
    "test:sdk:integration": "node scripts/sdk/integration.mjs",
    "test:cli": "pnpm --filter @kitsuden/cli build && pnpm --filter @kitsuden/cli test"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.4",
      "typescript": "5.9.3",
      "@types/node": "^22.19.0",
      "pg": "^8.20.0",
      "@types/pg": "^8.16.0",
      "postgres": "^3.4.5",
      "kysely": "^0.28.11",
      "hono": "4.13.13",
      "sharp": "^0.35.5",
      "nodemailer": "^10.2.1",
      "@modelcontextprotocol/sdk": "^1.32.1",
      "proxy-addr": "^2.0.8",
      "fast-uri@3": "^3.1.9",
      "path-to-regexp@8": "^8.4.2",
      "express-rate-limit@8": "^8.7.1",
      "ip-address@10": "^10.7.4",
      "@hono/node-server@1": "^1.19.14",
      "body-parser@2": "^2.4.0",
      "qs@6": "^6.16.1",
      "fast-xml-parser@5": "^5.7.0",
      "undici@8": "^8.12.2",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "vite@6": "^6.4.5",
      "postcss@8": "^8.5.31",
      "nanoid@3": "^3.3.20",
      "source-map-js@1": "^1.2.2",
      "zod@4": "^4.6.7",
      "tmp@0.2": "^0.2.7",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "immutable@4": "^4.3.9",
      "moment@2": "^2.31.0",
      "mysql2@3": "^3.24.6",
      "undici@7": "^7.30.1",
      "vue@3": "^3.5.44",
      "@vue/server-renderer@3": "^3.5.44",
      "vitest@4": "^4.1.12",
      "@vitest/mocker@4": "^4.1.12",
      "yaml@2": "^2.9.1",
      "uuid@11": "^11.1.1",
      "uuid@8": "^11.1.1",
      "cookie@0": "^0.7.0",
      "qs": "^6.16.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "pg": "^8.20.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@kitsuden/engine": "workspace:*",
    "@kitsuden/shared": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^17.6.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/core/*",
    "packages/kons/*",
    "packages/starters/kitsuden-starter-*"
  ]
}
